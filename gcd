#!/usr/bin/python3
import sys

def gcd(a, b):
    while b:
        a, b = b, a % b
    return a

# 最大公約数をリスト全体で計算する関数
def gcd_multiple(numbers):
    result = numbers[0]
    for num in numbers[1:]:
        result = gcd(result, num)
    return result

# 標準入力を直接読み込む
for line in sys.stdin:
    try:
        numbers = list(map(int, line.split()))  # 行のすべての数値をリストにする
        if len(numbers) < 2:
            print("エラー: 少なくとも2つの数値が必要です。", file=sys.stderr)
        else:
            print(f"GCD: {gcd_multiple(numbers)}")
